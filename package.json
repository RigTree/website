{
  "name": "rigtree-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "import:buildcores": "node scripts/import-buildcores.mjs /tmp/buildcores-open-db public/data/buildcores data/buildcores-index.json",
    "lint": "eslint .",
    "pages:build": "npx @cloudflare/next-on-pages --minify",
    "pages:deploy": "wrangler pages deploy .vercel/output/static --project-name=rigtree --branch=main",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.17",
    "@clerk/ui": "^1.25.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/supabase-js": "^2.110.3",
    "@tailwindcss/postcss": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@eslint/eslintrc": "^3.3.6",
    "@opennextjs/cloudflare": "^1.20.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.110.0"
  }
}
